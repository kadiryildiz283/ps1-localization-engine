    "id": 275,
    "original_length": 74,
    "text": "Greatest of all medieval alchemists.",
    "translation": "Ortaçağın en büyük simyacısı."
  },
  {
    "id": 276,
    "original_length": 102,
    "text": "Celebrated inventor of the Self-Stirring Cauldron.",
    "translation": "Kendiliğinden Karışan Kazanın ünlü mucidi."
  },
  {
    "id": 277,
    "original_length": 72,
    "text": "The witch who invented Floo Powder.",
    "translation": "Uçuş Tozunu icat eden cadı."
  },
  {
    "id": 278,
    "original_length": 58,
    "text": "Inventor of Cheering Charms.",
    "translation": "Neşelendirme Büyülerinin mucidi."
  },
  {
    "id": 279,
    "original_length": 70,
    "text": "Author of 'Charm Your Own Cheese'.",
    "translation": "'Kendi Peynirini Büyüle' kitabının yazarı."
  },
  {
    "id": 280,
    "original_length": 114,
    "text": "First person to fly across the Atlantic on a broomstick.",
    "translation": "Süpürgeyle Atlantik Okyanusu'nu geçen ilk kişi."
  },
  {
    "id": 281,
    "original_length": 94,
    "text": "Founder of the Society for Distressed Witches.",
    "translation": "Mağdur Cadılar Derneği'nin kurucusu."
  },
  {
    "id": 282,
    "original_length": 114,
    "text": "Sent to Azkaban for keeping Sphinxes in his back garden.",
    "translation": "Arka bahçesinde Sfenks beslediği için Azkaban'a gönderildi."
  },
  {
    "id": 283,
    "original_length": 44,
    "text": "Serial goblin-killer.",
    "translation": "Seri goblin avcısı."
  },
  {
    "id": 284,
    "original_length": 58,
    "text": "Inventor of the Sneakoscope.",
    "translation": "Sinsiölçerin mucidi."
  },
  {
    "id": 285,
    "original_length": 58,
    "text": "Famous magical theoretician.",
    "translation": "Ünlü büyü teorisyeni."
  },
  {
    "id": 286,
    "original_length": 108,
    "text": "Celebrated Seer and author of 'Unfogging the Future'.",
    "translation": "Ünlü Kahin ve 'Geleceği Aydınlatmak' kitabının yazarı."
  },
  {
    "id": 287,
    "original_length": 70,
    "text": "Wizard Chess Champion 1506 - 1588.",
    "translation": "Büyücü Satrancı Şampiyonu 1506 - 1588."
  },
  {
    "id": 288,
    "original_length": 68,
    "text": "First known victim of Dragon Pox.",
    "translation": "Ejderha Çiçeği hastalığının bilinen ilk kurbanı."
  },
  {
    "id": 289,
